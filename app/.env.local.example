# Copy this file to .env.local and fill in real values for local development.
# Never commit .env.local — it is already covered by .gitignore.

# Resend API key (Resend dashboard -> API Keys)
RESEND_API_KEY=re_xxxxxxxxx

# Where contact-form enquiries should be delivered
CONTACT_EMAIL=your-email@example.com

# Verified sender address/display name (requires a verified domain in Resend
# for anything other than Resend's own onboarding@resend.dev sandbox address)
CONTACT_FROM_EMAIL=GrowthU <hello@yourdomain.com>
